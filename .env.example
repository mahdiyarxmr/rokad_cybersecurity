# Local development template. Copy to .env and replace every value.
# Do not use passwords or tokens that were previously committed upstream.
# Production refuses published defaults and will not boot without real secrets.

PORT=4000
NODE_ENV=development
APP_NAME=Rokad-Platform
APP_URL=http://localhost:4000
BASE_DOMAIN=localhost

POSTGRES_USER=rokad_user
POSTGRES_PASSWORD=replace-with-local-db-password
POSTGRES_DB=rokad_db
POSTGRES_PORT=5432
DATABASE_URL="postgresql://rokad_user:replace-with-local-db-password@localhost:5432/rokad_db?schema=public"

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-local-redis-password
REDIS_URL="redis://:replace-with-local-redis-password@localhost:6379"

# At least 32 random characters. Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET="replace-with-unique-access-secret-32b"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="replace-with-unique-refresh-secret-32"
JWT_REFRESH_EXPIRES_IN="7d"

MINIO_ROOT_USER=replace-minio-user
MINIO_ROOT_PASSWORD=replace-with-local-minio-password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=localhost
MINIO_USE_SSL=false
MINIO_BUCKET_NAME=rokad-assets

SUPER_ADMIN_EMAIL=admin@example.local
SUPER_ADMIN_PHONE=09120000000
SUPER_ADMIN_PASSWORD=replace-with-unique-admin-password

# 64 hex characters (32 bytes). openssl rand -hex 32
APP_ENCRYPTION_KEY="replace-with-64-hex-chars-not-a-placeholder-value-0123456789abcd"
APP_BLIND_INDEX_KEY="replace-with-another-64-hex-key-not-a-placeholder-value-0123456789ab"
AUDIT_HASH_PEPPER="replace-with-unique-audit-pepper-32chars"

# Comma-separated browser origins. Required in production. Never use *.
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Optional. Leave empty unless you have rotated this integration.
TELEGRAM_AUDIT_BOT_TOKEN=
TELEGRAM_AUDIT_CHANNEL_ID=
AMOOT_API_KEY=
AMOOT_SENDER_LINE=

ENABLE_HEARTBEAT=false
BETTERSTACK_HEARTBEAT_URL=
HEARTBEAT_INTERVAL_SECONDS=60
HEALTH_INTERNAL_TOKEN=replace-with-internal-health-token

JSON_BODY_LIMIT=6mb
MEDIA_URL_TTL_SECONDS=21600
ENABLE_SWAGGER=false
