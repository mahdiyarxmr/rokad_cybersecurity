datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum TenantType {
  PLATFORM
  SCHOOL
  COLLEGE
  CLUB
  PROJECT_INSTITUTE
  MULTI_CAMPUS_NETWORK
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  PENDING_SETUP
}

enum BrandTheme {
  ECOSYSTEM
  MALE
  FEMALE
  COLLEGE
  CLUB
}

enum UserRole {
  SUPER_ADMIN
  SCHOOL_ADMIN
  TEACHER
  STUDENT
  PARENT
  STAFF
  COACH
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_ACTIVATION
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum CalendarSystem {
  JALALI
  GREGORIAN
}

enum EnrollmentStatus {
  ACTIVE
  TRANSFERRED
  GRADUATED
  DROPPED
}

enum LessonType {
  GENERAL
  NON_TECHNICAL_COMPETENCY
  BASIC_COMPETENCY
  TECHNICAL_MODULAR_COMPETENCY
  TECHNICAL_PRACTICAL_COMPETENCY
  SPECIALIZED
  PRACTICAL
  OPTIONAL
  EXTRACURRICULAR
}

enum DayOfWeek {
  SATURDAY
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
}

enum CoachType {
  ACADEMIC_COUNSELOR
  DISCIPLINARY
  SPORTS
  CULTURAL
  HEALTH
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  HOURLY
  CONTRACT
}

enum ParentRelationType {
  FATHER
  MOTHER
  LEGAL_GUARDIAN
}

// Phase 3 Enums
enum AttendanceStatus {
  PRESENT
  ABSENT
  TARDY
  EXCUSED_ABSENT
  EXPELLED
}

enum TeacherAttendanceStatus {
  PRESENT
  ABSENT
  LEAVE_AUTHORIZED
  LEAVE_UNAUTHORIZED
}

enum DisciplinaryRewardType {
  POSITIVE
  NEGATIVE
  WARNING
  HOMEWORK_INCOMPLETE
  EXCELLENT
  NONE
}

enum SubmissionStatus {
  PENDING
  SUBMITTED
  LATE
  GRADED
  RESUBMIT_REQUIRED
}

enum EventType {
  ACADEMIC
  HOLIDAY
  EXAM
  MEETING
  CULTURAL
  SPORTS
  EXCURSION
  STARTUP_WEEKEND
}

enum TargetAudience {
  ALL
  STUDENTS
  TEACHERS
  PARENTS
  STAFF
  SPECIFIC_CLASSES
}

enum PollType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  RATING_SCALE
}

enum BookingStatus {
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum MatterType {
  POSITIVE
  NEGATIVE
  WARNING
  SUSPENSION
  COUNSELING_REFERRAL
}

// Phase 4 Enums
enum LessonPlanSessionStatus {
  PLANNED
  COMPLETED
  IN_PROGRESS
  CANCELLED
  MAKEUP_REQUIRED
}

enum QuestionType {
  MULTIPLE_CHOICE
  DESCRIPTIVE
  TRUE_FALSE
  FILL_IN_BLANK
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
  OLYMPIAD
}

enum ExamType {
  ONLINE
  PAPER_BASED
  HYBRID
}

enum ExamStatus {
  DRAFT
  SCHEDULED
  RUNNING
  FINISHED
  CANCELLED
}

enum ParticipationStatus {
  IN_PROGRESS
  SUBMITTED
  TIMED_OUT
  ABSENT
}

enum GradeType {
  CLASS_ACTIVITY
  QUIZ
  HOMEWORK_GRADE
  MIDTERM
  FINAL_TERM_1
  FINAL_TERM_2
  CUSTOM
}

model Tenant {
  id             String         @id @default(uuid())
  type           TenantType     @default(SCHOOL)
  name           String
  slug           String         @unique
  subdomain      String?        @unique
  customDomain   String?        @unique
  theme          BrandTheme     @default(ECOSYSTEM)
  status         TenantStatus   @default(ACTIVE)
  calendarSystem CalendarSystem @default(JALALI)
  logoUrl        String?
  phone          String?
  email          String?
  address        String?
  settings       Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // Password Vault (Zero-Knowledge Envelope Encryption)
  vaultPublicKey           String?   @db.Text
  vaultEncryptedPrivateKey String?   @db.Text
  vaultKeySalt             String?
  vaultKeyHash             String?
  vaultKeyUpdatedAt        DateTime?

  // Multi-Campus / Multi-Branch Hierarchy
  parentTenantId String?
  parentTenant   Tenant?  @relation("TenantHierarchy", fields: [parentTenantId], references: [id], onDelete: SetNull)
  subTenants     Tenant[] @relation("TenantHierarchy")

  users         User[]
  featureFlags  TenantFeatureFlag[]
  auditLogs     AuditLog[]
  tokenFamilies RefreshTokenFamily[]

  // Phase 2 ERP Relations
  academicYears       AcademicYear[]
  terms               Term[]
  educationalLevels   EducationalLevel[]
  studyFields         StudyField[]
  lessons             Lesson[]
  classrooms          Classroom[]
  classEnrollments    ClassEnrollment[]
  classSchedules      ClassSchedule[]
  schoolRoles         SchoolRole[]
  userSchoolRoles     UserSchoolRole[]
  permissionOverrides UserPermissionOverride[]
  studentProfiles     StudentProfile[]
  teacherProfiles     TeacherProfile[]
  teacherLessons      TeacherLesson[]
  coachProfiles       CoachProfile[]
  staffProfiles       StaffProfile[]
  parentProfiles      ParentProfile[]
  parentLinks         ParentStudentLink[]
  profileBlogs        ProfileBlog[]
  blogLikes           ProfileBlogLike[]
  blogComments        ProfileBlogComment[]
  schoolProfile       SchoolProfile?

  // Phase 3 Operations Relations
  studentAttendances  StudentAttendance[]
  teacherAttendances  TeacherAttendance[]
  homeworks           Homework[]
  homeworkSubmissions HomeworkSubmission[]
  schoolEvents        SchoolEvent[]
  polls               Poll[]
  pollVotes           PollVote[]
  parentVisitSlots    ParentVisitSlot[]
  parentVisitBookings ParentVisitBooking[]
  disciplinaryMatters DisciplinaryMatter[]
  tenantHolidays      TenantHoliday[]

  // Phase 4 LMS & Exam Relations
  lessonPlans        LessonPlan[]
  questionCategories QuestionCategory[]
  questions          Question[]
  exams              Exam[]
  examClassrooms     ExamClassroom[]
  examParticipations ExamParticipation[]
  gradeEntries       GradeEntry[]
  podmans            Podman[]
  podmanGrades       PodmanGrade[]

  // Phase 5 Relations
  courseMaterials    CourseMaterial[]
  materialClassrooms MaterialClassroom[]
  chatChannels       ChatChannel[]
  chatChannelMembers ChatChannelMember[]
  chatMessages       ChatMessage[]

  // Phase 6 Relations
  feePlans             FeePlan[]
  studentFeeContracts  StudentFeeContract[]
  feeInstallments      FeeInstallment[]
  paymentTransactions  PaymentTransaction[]
  feePayments          FeePayment[]
  feeReceipts          FeeReceipt[]
  staffPayrollProfiles StaffPayrollProfile[]
  payrollSlips         PayrollSlip[]
  payrollItems         PayrollItem[]
  teacherContracts     TeacherContract[]
  payrollAdjustments   PayrollAdjustment[]

  // Phase 7 SaaS SuperAdmin Relations
  subscriptions TenantSubscription[]

  // Coaching & Mentorship Relations
  studentCoachLinks     StudentCoachLink[]
  coachingSessions      CoachingSession[]
  coachingExtraRequests CoachingExtraRequest[]

  // Academic Messaging System Relations
  academicMessages          AcademicMessage[]
  academicMessageRecipients AcademicMessageRecipient[]

  // Security & Active Sessions
  userSessions UserSession[]

  // Ka Platform Gamification
  kaActivities        KaActivity[]
  kaStudentActivities KaStudentActivity[]
  kaRewards           KaReward[]
  kaStudentRewards    KaStudentReward[]

  // SMS Engine Relations
  smsLogs             SmsLog[]
  smsTemplates        SmsTemplate[]
  smsQuickTemplates   SmsQuickTemplate[]
  smsGatewayConfig    SmsGatewayConfig?

  // Rokad Business Club Relations
  clubMemberships                ClubMembership[]
  clubRoadmapMilestones          ClubRoadmapMilestone[]
  clubStudentMilestoneProgresses ClubStudentMilestoneProgress[]
  clubChallenges                 ClubChallenge[]
  clubChallengeSubmissions       ClubChallengeSubmission[]

  @@index([status])
  @@index([parentTenantId])
  @@index([createdAt])
}

model User {
  id                   String     @id @default(uuid())
  tenantId             String
  tenant               Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email                String?
  phone                String?
  nationalId           String?
  nationalIdBlindIndex String?
  username             String?
  passwordHash         String
  encryptedPassword    String?    @db.Text
  firstName            String
  lastName             String
  gender               Gender?
  role                 UserRole   @default(STUDENT)
  isPlatformAdmin      Boolean    @default(false)
  status               UserStatus @default(ACTIVE)
  avatarUrl            String?
  metadata             Json?
  lastLoginAt          DateTime?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  // Two-Factor Authentication (TOTP RFC 6238)
  twoFactorEnabled       Boolean   @default(false)
  twoFactorSecret        String? // AES-256-GCM encrypted
  twoFactorRecoveryCodes String[]  @default([])
  twoFactorConfirmedAt   DateTime?
  twoFactorLastStepUpAt  DateTime? // Timestamp of last sensitive step-up verification

  tokenFamilies RefreshTokenFamily[]
  sessions      UserSession[]
  auditLogs     AuditLog[]

  // Phase 2 Relations
  userSchoolRoles     UserSchoolRole[]
  permissionOverrides UserPermissionOverride[] @relation("UserPermissionOverrides")
  grantedOverrides    UserPermissionOverride[] @relation("GrantedOverrides")
  studentProfile      StudentProfile?
  teacherProfile      TeacherProfile?
  coachProfile        CoachProfile?
  staffProfile        StaffProfile?
  parentProfile       ParentProfile?
  profileBlogs        ProfileBlog[]
  blogLikes           ProfileBlogLike[]
  blogComments        ProfileBlogComment[]
  mentoredClasses     Classroom[]              @relation("ClassMentor")

  // Phase 3 Relations
  recordedStudentAttendances StudentAttendance[]  @relation("RecordedStudentAttendance")
  recordedTeacherAttendances TeacherAttendance[]  @relation("RecordedTeacherAttendance")
  gradedSubmissions          HomeworkSubmission[] @relation("GradedSubmission")
  createdEvents              SchoolEvent[]        @relation("CreatedEvent")
  createdPolls               Poll[]               @relation("CreatedPoll")
  pollVotes                  PollVote[]
  reportedMatters            DisciplinaryMatter[] @relation("ReportedMatter")

  // Phase 4 Relations
  createdQuestions     Question[]    @relation("CreatedQuestion")
  recordedGrades       GradeEntry[]  @relation("RecordedGrade")
  recordedPodmanGrades PodmanGrade[] @relation("RecordedPodmanGrade")

  // Phase 5 Relations
  chatMemberships  ChatChannelMember[]
  sentChatMessages ChatMessage[]       @relation("SentChatMessage")

  // Phase 6 Relations
  paymentTransactions        PaymentTransaction[] @relation("PayerTransactions")
  issuedFeeReceipts          FeeReceipt[]         @relation("IssuedFeeReceipts")
  recordedFeePayments        FeePayment[]         @relation("RecordedPayments")
  checkStatusChangedPayments FeePayment[]         @relation("CheckStatusChangers")
  staffPayrollProfile        StaffPayrollProfile?
  payrollSlips               PayrollSlip[]        @relation("EmployeePayrollSlips")
  approvedPayrollSlips       PayrollSlip[]        @relation("ApprovedPayrollSlips")
  editedPayrollSlips         PayrollSlip[]        @relation("EditedPayrollSlips")
  cancelledPayrollSlips      PayrollSlip[]        @relation("CancelledPayrollSlips")
  teacherContracts           TeacherContract[]    @relation("TeacherContracts")
  createdContracts           TeacherContract[]    @relation("CreatedContracts")
  teacherAdjustments         PayrollAdjustment[]  @relation("TeacherAdjustments")
  createdAdjustments         PayrollAdjustment[]  @relation("CreatedAdjustments")
  pushSubscriptions          PushSubscription[]

  // Coaching Relations
  studentCoachingLinks    StudentCoachLink[]     @relation("StudentCoachingLinks")
  coachCoachingLinks      StudentCoachLink[]     @relation("CoachCoachingLinks")
  studentCoachingSessions CoachingSession[]      @relation("StudentCoachingSessions")
  coachCoachingSessions   CoachingSession[]      @relation("CoachCoachingSessions")
  studentExtraRequests    CoachingExtraRequest[] @relation("StudentExtraRequests")
  coachExtraRequests      CoachingExtraRequest[] @relation("CoachExtraRequests")

  // Academic Messaging System Relations
  sentAcademicMessages     AcademicMessage[]          @relation("SentAcademicMessages")
  receivedAcademicMessages AcademicMessageRecipient[] @relation("ReceivedAcademicMessages")

  // SMS Engine Relations
  receivedSmsLogs          SmsLog[]                   @relation("RecipientSmsLogs")
  sentSmsLogs              SmsLog[]                   @relation("SenderSmsLogs")

  // Rokad Business Club Relations
  clubMembership           ClubMembership?            @relation("UserClubMembership")
  studentClubMilestones    ClubStudentMilestoneProgress[] @relation("StudentClubMilestones")
  approvedClubMilestones   ClubStudentMilestoneProgress[] @relation("ApprovedMilestones")
  studentClubSubmissions   ClubChallengeSubmission[]  @relation("StudentClubSubmissions")
  gradedClubSubmissions    ClubChallengeSubmission[]  @relation("GradedClubSubmissions")

  @@unique([tenantId, email])
  @@unique([tenantId, phone])
  @@unique([tenantId, username])
  @@index([tenantId, nationalIdBlindIndex])
  @@index([tenantId, role])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

model RefreshTokenFamily {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  isRevoked     Boolean  @default(false)
  revokedReason String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tokens RefreshToken[]

  @@index([tenantId, userId])
  @@index([userId, isRevoked])
}

model RefreshToken {
  id        String             @id @default(uuid())
  familyId  String
  family    RefreshTokenFamily @relation(fields: [familyId], references: [id], onDelete: Cascade)
  tokenHash String             @unique
  isUsed    Boolean            @default(false)
  expiresAt DateTime
  revokedAt DateTime?
  ipAddress String?
  userAgent String?
  createdAt DateTime           @default(now())

  @@index([familyId, isUsed])
  @@index([expiresAt])
}

model FeatureFlag {
  id             String   @id @default(uuid())
  key            String   @unique
  name           String
  description    String?
  category       String   @default("GENERAL")
  defaultEnabled Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenantOverrides TenantFeatureFlag[]

  @@index([category])
}

model TenantFeatureFlag {
  id            String      @id @default(uuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  featureFlagId String
  featureFlag   FeatureFlag @relation(fields: [featureFlagId], references: [id], onDelete: Cascade)
  isEnabled     Boolean
  config        Json?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([tenantId, featureFlagId])
  @@index([tenantId, isEnabled])
}

model AuditLog {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action       String
  entity       String
  entityId     String?
  oldValues    Json?
  newValues    Json?
  ipAddress    String?
  userAgent    String?
  previousHash String? // Hash of preceding log record (immutable chain)
  hash         String? // SHA-256(data + previousHash + pepper)
  createdAt    DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, entity, entityId])
  @@index([tenantId, action])
  @@index([userId, createdAt])
}

model UserSession {
  id               String   @id @default(uuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionTokenHash String   @unique
  ipAddress        String?
  userAgent        String?
  browser          String?
  os               String?
  deviceType       String? // 'DESKTOP' | 'MOBILE' | 'TABLET'
  lastActiveAt     DateTime @default(now())
  createdAt        DateTime @default(now())
  isRevoked        Boolean  @default(false)

  @@index([userId, isRevoked])
  @@index([tenantId, userId])
}

// ==========================================
// PHASE 2: CORE ERP & ACADEMIC STRUCTURE
// ==========================================

model AcademicYear {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String // e.g. "۱۴۰۴-۱۴۰۵"
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  terms               Term[]
  classrooms          Classroom[]
  classEnrollments    ClassEnrollment[]
  studentAttendances  StudentAttendance[]
  disciplinaryMatters DisciplinaryMatter[]

  // Phase 4
  lessonPlans  LessonPlan[]
  exams        Exam[]
  gradeEntries GradeEntry[]
  podmanGrades PodmanGrade[]

  // Phase 5
  courseMaterials CourseMaterial[]

  // Phase 6
  feePlans            FeePlan[]
  studentFeeContracts StudentFeeContract[]
  teacherContracts    TeacherContract[]

  @@unique([tenantId, name])
  @@index([tenantId, isCurrent])
}

model Term {
  id             String       @id @default(uuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  name           String // e.g. "نیم‌سال اول", "نیم‌سال دوم", "تابستان"
  startDate      DateTime
  endDate        DateTime
  isCurrent      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  lessonPlans     LessonPlan[]
  exams           Exam[]
  gradeEntries    GradeEntry[]
  courseMaterials CourseMaterial[]

  @@unique([academicYearId, name])
  @@index([tenantId, academicYearId])
}

model EducationalLevel {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String // e.g. "متوسطه اول", "متوسطه دوم", "کالج"
  code       String // e.g. "HIGH_SCHOOL_2"
  orderIndex Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  studyFields StudyField[]
  classrooms  Classroom[]
  lessons     Lesson[]
  feePlans    FeePlan[]

  @@unique([tenantId, name])
  @@unique([tenantId, code])
  @@index([tenantId, orderIndex])
}

model StudyField {
  id        String           @id @default(uuid())
  tenantId  String
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  levelId   String
  level     EducationalLevel @relation(fields: [levelId], references: [id], onDelete: Cascade)
  name      String // e.g. "ریاضی و فیزیک", "علوم تجربی", "شبکه و نرم‌افزار"
  code      String // e.g. "MATH_PHYSICS"
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  classrooms Classroom[]
  lessons    Lesson[]

  @@unique([tenantId, levelId, name])
  @@unique([tenantId, code])
  @@index([tenantId, levelId])
}

model Lesson {
  id          String           @id @default(uuid())
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  levelId     String
  level       EducationalLevel @relation(fields: [levelId], references: [id], onDelete: Cascade)
  fieldId     String?
  field       StudyField?      @relation(fields: [fieldId], references: [id], onDelete: SetNull)
  name        String // e.g. "حسابان ۱", "فیزیک پیشرفته", "ادبیات فارسی"
  code        String // e.g. "CALC-10"
  unitCount   Int              @default(1)
  type        LessonType       @default(GENERAL)
  description String?
  isModular   Boolean          @default(false) // آیا درس به صورت پودمانی است؟
  podmanCount Int              @default(5) // تعداد پودمان‌ها (معمولاً ۵)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  schedules          ClassSchedule[]     @relation("LessonSchedules")
  secondSchedules    ClassSchedule[]     @relation("SecondLessonSchedules")
  studentAttendances StudentAttendance[]
  homeworks          Homework[]

  // Phase 4 Relations
  lessonPlans        LessonPlan[]
  questionCategories QuestionCategory[]
  questions          Question[]
  exams              Exam[]
  gradeEntries       GradeEntry[]
  podmans            Podman[]
  podmanGrades       PodmanGrade[]

  // Phase 5 Relations
  courseMaterials CourseMaterial[]
  teacherLessons  TeacherLesson[]

  // Rokad Business Club Relations
  clubRoadmapMilestones ClubRoadmapMilestone[]

  @@unique([tenantId, code])
  @@index([tenantId, levelId])
}

model Classroom {
  id             String           @id @default(uuid())
  tenantId       String
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  levelId        String
  level          EducationalLevel @relation(fields: [levelId], references: [id], onDelete: Cascade)
  fieldId        String?
  field          StudyField?      @relation(fields: [fieldId], references: [id], onDelete: SetNull)
  mentorId       String?
  mentor         User?            @relation("ClassMentor", fields: [mentorId], references: [id], onDelete: SetNull)
  name           String // e.g. "کلاس دهم ریاضی ۱"
  code           String // e.g. "CLS-10-M1"
  capacity       Int              @default(30)
  roomNumber     String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  enrollments        ClassEnrollment[]
  schedules          ClassSchedule[]
  studentAttendances StudentAttendance[]
  homeworks          Homework[]

  // Phase 4 Relations
  examClassrooms ExamClassroom[]
  gradeEntries   GradeEntry[]
  podmanGrades   PodmanGrade[]

  // Phase 5 Relations
  materialClassrooms MaterialClassroom[]
  chatChannels       ChatChannel[]
  academicMessages   AcademicMessage[]
  feePlans           FeePlan[]

  @@unique([tenantId, academicYearId, name])
  @@unique([tenantId, academicYearId, code])
  @@index([tenantId, academicYearId])
}

model ClassEnrollment {
  id             String           @id @default(uuid())
  tenantId       String
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  classroomId    String
  classroom      Classroom        @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  studentId      String
  student        StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status         EnrollmentStatus @default(ACTIVE)
  enrolledAt     DateTime         @default(now())

  @@unique([classroomId, studentId])
  @@index([tenantId, studentId])
  @@index([tenantId, classroomId])
}

model ClassSchedule {
  id          String         @id @default(uuid())
  tenantId    String
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classroomId String
  classroom   Classroom      @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson         @relation("LessonSchedules", fields: [lessonId], references: [id], onDelete: Cascade)
  teacherId   String
  teacher     TeacherProfile @relation("TeacherSchedules", fields: [teacherId], references: [id], onDelete: Cascade)

  // منطق یک هفته در میان (دو درس و دو دبیر چرخشی: هفته اول و هفته دوم)
  isSplitPeriod   Boolean         @default(false)
  secondLessonId  String?
  secondLesson    Lesson?         @relation("SecondLessonSchedules", fields: [secondLessonId], references: [id], onDelete: SetNull)
  secondTeacherId String?
  secondTeacher   TeacherProfile? @relation("SecondTeacherSchedules", fields: [secondTeacherId], references: [id], onDelete: SetNull)
  dayOfWeek       DayOfWeek
  periodNumber    Int // زنگ ۱، ۲، ۳
  startTime       String // "08:00"
  endTime         String // "09:30"
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  studentAttendances StudentAttendance[]

  @@unique([classroomId, dayOfWeek, periodNumber])
  @@index([tenantId, classroomId])
  @@index([tenantId, teacherId])
  @@index([tenantId, dayOfWeek])
}

// ==========================================
// PHASE 2: DYNAMIC RBAC & PERMISSIONS
// ==========================================

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique // e.g. "attendance.write", "grades.manage"
  module      String // e.g. "ERP_ACADEMIC", "LMS", "FINANCE"
  name        String // e.g. "ثبت و ویرایش حضور و غیاب"
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@index([module])
}

model SchoolRole {
  id          String    @id @default(uuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String // e.g. "ناظم پایه دهم", "مشاور تحصیلی", "حسابدار"
  description String?
  isSystem    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  permissions RolePermission[]
  userRoles   UserSchoolRole[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, deletedAt])
}

model RolePermission {
  id           String     @id @default(uuid())
  schoolRoleId String
  schoolRole   SchoolRole @relation(fields: [schoolRoleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([schoolRoleId, permissionId])
  @@index([schoolRoleId])
}

model UserSchoolRole {
  id           String     @id @default(uuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolRoleId String
  schoolRole   SchoolRole @relation(fields: [schoolRoleId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([tenantId, userId, schoolRoleId])
  @@index([tenantId, userId])
}

enum PermissionOverrideEffect {
  GRANT
  REVOKE
}

model UserPermissionOverride {
  id             String                   @id @default(uuid())
  tenantId       String
  tenant         Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId         String
  user           User                     @relation("UserPermissionOverrides", fields: [userId], references: [id], onDelete: Cascade)
  permissionCode String
  effect         PermissionOverrideEffect
  grantedById    String
  grantedBy      User                     @relation("GrantedOverrides", fields: [grantedById], references: [id], onDelete: Cascade)
  reason         String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  deletedAt      DateTime?

  @@unique([tenantId, userId, permissionCode])
  @@index([tenantId, userId])
  @@index([tenantId, deletedAt])
}

// ==========================================
// PHASE 2: MEMBER PROFILES & RELATIONSHIPS
// ==========================================

model StudentProfile {
  id                     String    @id @default(uuid())
  tenantId               String
  tenant                 Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId                 String    @unique
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentCode            String // شماره دانش‌آموزی
  nationalCode           String? // کد ملی
  nationalCodeBlindIndex String? // HMAC-SHA256 Blind Index for fast search
  fatherName             String?
  birthDate              DateTime?
  address                String?
  medicalNotes           String?

  // --- فیلدهای شناسنامه‌ای و هویتی (مطابق SAMPLE.xlsx) ---
  gradeLevel              String? // پایه تحصیلی (دهم، یازدهم، دوازدهم)
  birthPlace              String? // محل تولد
  certificateNumber       String? // سریال شناسنامه
  certificateSeriesLetter String? // سری حرفی (الف، ب، ...)
  certificateSeriesNumber String? // سری عددی
  issuePlace              String? // محل صدور
  physicalCondition       String? // وضعیت جسمانی

  // --- مشخصات پدر ---
  fatherFullName          String? // نام و نام‌خانوادگی پدر
  fatherNationalId        String? // کد ملی پدر
  fatherEducation         String? // تحصیلات پدر
  fatherOccupation        String? // شغل پدر
  fatherPhone             String? // شماره همراه پدر
  fatherWorkAddress       String? // آدرس محل کار پدر

  // --- مشخصات مادر ---
  motherFullName          String? // نام و نام‌خانوادگی مادر
  motherNationalId        String? // کد ملی مادر
  motherEducation         String? // تحصیلات مادر
  motherOccupation        String? // شغل مادر
  motherPhone             String? // شماره همراه مادر
  motherWorkAddress       String? // آدرس محل کار مادر

  // --- سکونت و ارتباطات ---
  homeAddress             String? // آدرس منزل
  landlinePhone           String? // شماره ثابت منزل
  studentMobile           String? // شماره همراه دانش‌آموز

  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  enrollments         ClassEnrollment[]
  parentLinks         ParentStudentLink[]
  studentAttendances  StudentAttendance[]
  homeworkSubmissions HomeworkSubmission[]
  parentVisitBookings ParentVisitBooking[]
  disciplinaryMatters DisciplinaryMatter[]

  // Phase 4 Relations
  examParticipations ExamParticipation[]
  gradeEntries       GradeEntry[]
  podmanGrades       PodmanGrade[]

  // Phase 6 Relations
  feeContracts StudentFeeContract[]

  // Ka Platform Gamification
  kaScore             Float               @default(0)
  kaToken             Float               @default(0)
  kaStudentActivities KaStudentActivity[]
  kaStudentRewards    KaStudentReward[]

  @@unique([tenantId, studentCode])
  @@index([tenantId, nationalCode])
  @@index([tenantId, nationalCodeBlindIndex])
}

model TeacherProfile {
  id             String         @id @default(uuid())
  tenantId       String
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId         String         @unique
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  personnelCode  String? // کد پرسنلی
  speciality     String? // تخصص (e.g. "ریاضیات و هندسه")
  degree         String? // مدرک تحصیلی (e.g. "کارشناسی ارشد")
  studyField     String? // رشته تحصیلی (e.g. "آموزش ریاضی")
  homeAddress    String? // آدرس منزل
  landlinePhone  String? // شماره ثابت
