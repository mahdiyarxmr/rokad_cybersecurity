  occupation  String? // شغل
  education   String? // تحصیلات
  workPhone   String?
  homeAddress String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  studentLinks        ParentStudentLink[]
  parentVisitBookings ParentVisitBooking[]

  @@index([tenantId])
}

model ParentStudentLink {
