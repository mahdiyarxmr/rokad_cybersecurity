  @@index([tenantId, teacherId])
  @@index([tenantId, lessonId])
}

model CoachProfile {
  id        String    @id @default(uuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String    @unique
