// ==========================================
// PHASE 2: PROFILES & SCHOOL BLOG
// ==========================================

model ProfileBlog {
  id                 String    @id @default(uuid())
  tenantId           String
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  authorId           String
  author             User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title              String
  slug               String
  content            String
  coverImageUrl      String?
  postType           String    @default("STANDARD") // STANDARD, SLIDESHOW, DOCUMENT, ANNOUNCEMENT
  mediaUrls          String[]  @default([]) // Multiple slide images
  attachments        Json? // [{ name: string, url: string, size?: number, mimeType?: string }]
  audienceType       String    @default("ALL") // ALL, ROLES, CLASSROOMS
  targetRoles        String[]  @default([]) // ['STUDENT', 'PARENT', 'TEACHER', 'STAFF']
  targetClassroomIds String[]  @default([]) // Classroom UUIDs
  isPinned           Boolean   @default(false)
  allowComments      Boolean   @default(true)
  isPublished        Boolean   @default(true)
  publishedAt        DateTime? @default(now())
  tags               String[]  @default([])
  viewCount          Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  likes    ProfileBlogLike[]
  comments ProfileBlogComment[]

  @@unique([tenantId, slug])
  @@index([tenantId, authorId])
  @@index([tenantId, isPublished])
  @@index([tenantId, isPinned])
  @@index([tenantId, deletedAt])
}

model ProfileBlogLike {
  id        String      @id @default(uuid())
  tenantId  String
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  blogId    String
  blog      ProfileBlog @relation(fields: [blogId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([blogId, userId])
  @@index([tenantId, blogId])
}

model ProfileBlogComment {
  id         String      @id @default(uuid())
  tenantId   String
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  blogId     String
  blog       ProfileBlog @relation(fields: [blogId], references: [id], onDelete: Cascade)
  authorId   String
  author     User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content    String
  isApproved Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  deletedAt  DateTime?

  @@index([tenantId, blogId])
  @@index([tenantId, deletedAt])
}

model SchoolProfile {
  id             String   @id @default(uuid())
  tenantId       String   @unique
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  motto          String? // شعار مدرسه
  aboutHtml      String?
  headerImageUrl String?
  socialLinks    Json?
  managerName    String?
  managerMessage String?
  achievements   Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ==========================================
// PHASE 3: DAILY ACADEMIC OPERATIONS
// ==========================================

model StudentAttendance {
  id             String           @id @default(uuid())
  tenantId       String
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  classroomId    String
  classroom      Classroom        @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  lessonId       String?
  lesson         Lesson?          @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  scheduleId     String?
  schedule       ClassSchedule?   @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  studentId      String
  student        StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date           String // format: "YYYY-MM-DD" e.g. "2026-09-01"
  periodNumber   Int? // زنگ کلاسی (null = روزانه کل)
  status         AttendanceStatus @default(PRESENT)
  delayMinutes   Int              @default(0)
  reason         String? // دلیل غیبت یا تاخیر

  // دفتر کلاسی هوشمند: نمره پرسش کلاسی (از ۲۰)، موارد انضباطی/تشویقی و یادداشت جلسه
  oralGrade            Float?                  // نمره پرسش کلاسی (از ۲۰)
  rewardDisciplineType DisciplinaryRewardType? // نوع مورد انضباطی یا تشویقی
  rewardDisciplineNote String?                 // شرح مورد تشویقی یا انضباطی
  sessionNote          String?                 // یادداشت جلسه دبیر برای این دانش‌آموز

  recordedById   String
  recordedBy     User             @relation("RecordedStudentAttendance", fields: [recordedById], references: [id], onDelete: Cascade)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([tenantId, classroomId, studentId, date, periodNumber])
  @@index([tenantId, date, status])
  @@index([tenantId, studentId, date])
  @@index([tenantId, classroomId, date])
}

model TeacherAttendance {
  id           String                  @id @default(uuid())
  tenantId     String
  tenant       Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacherId    String
  teacher      TeacherProfile          @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  date         String // format: "YYYY-MM-DD"
  entryTime    String? // "07:45"
  exitTime     String? // "14:30"
  status       TeacherAttendanceStatus @default(PRESENT)
  notes        String?
  recordedById String?
  recordedBy   User?                   @relation("RecordedTeacherAttendance", fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@unique([tenantId, teacherId, date])
  @@index([tenantId, date])
}

model Homework {
  id                   String         @id @default(uuid())
  tenantId             String
  tenant               Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classroomId          String
  classroom            Classroom      @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  lessonId             String
  lesson               Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  teacherId            String
  teacher              TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  title                String
  description          String
  attachmentUrls       String[]       @default([])
  dueDate              DateTime
  maxScore             Float          @default(20)
  isGraded             Boolean        @default(true)
  allowLateSubmissions Boolean        @default(false)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  submissions HomeworkSubmission[]

  @@index([tenantId, classroomId, dueDate])
  @@index([tenantId, teacherId])
}

model HomeworkSubmission {
  id             String           @id @default(uuid())
  tenantId       String
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  homeworkId     String
  homework       Homework         @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  studentId      String
  student        StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  content        String? // یادداشت یا توضیحات دانش‌آموز
  attachmentUrls String[]         @default([])
  submittedAt    DateTime         @default(now())
  status         SubmissionStatus @default(SUBMITTED)
  score          Float?
  feedback       String? // بازخورد دبیر
  gradedAt       DateTime?
  gradedById     String?
  gradedBy       User?            @relation("GradedSubmission", fields: [gradedById], references: [id], onDelete: SetNull)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([homeworkId, studentId])
  @@index([tenantId, studentId])
}

model SchoolEvent {
  id              String         @id @default(uuid())
  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  eventType       EventType      @default(ACADEMIC)
  startDate       DateTime
  endDate         DateTime
  isAllDay        Boolean        @default(false)
  targetAudience  TargetAudience @default(ALL)
  targetClassIds  String[]       @default([])
